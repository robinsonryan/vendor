{
    "name": "robinsonryan/vendor",
    "description": "Standalone vendor/supplier management for Laravel applications",
    "keywords": [
        "laravel",
        "vendor",
        "supplier",
        "management"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Robinson"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/robinsonryan/taxon.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "robinsonryan/taxon": "^0.6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RobinsonRyan\\Vendor\\": "src/",
            "RobinsonRyan\\Vendor\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobinsonRyan\\Vendor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobinsonRyan\\Vendor\\VendorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyze": "phpstan analyse",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "quality": [
            "@lint:check",
            "@analyze",
            "@refactor:check",
            "@test"
        ]
    }
}
