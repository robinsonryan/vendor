{
    "name": "robinsonryan/vendor",
    "description": "Standalone vendor/supplier management for Laravel applications",
    "keywords": ["laravel", "vendor", "supplier", "management"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Robinson"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "robinsonryan/taxon": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RobinsonRyan\\Vendor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobinsonRyan\\Vendor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobinsonRyan\\Vendor\\VendorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
